# Copy to .env for local runs. Never commit real secrets.
KOSHSETU_ENVIRONMENT=local
KOSHSETU_DATABASE_URL=sqlite:///./data/koshsetu.db
KOSHSETU_JWT_SECRET=change-me-local-only
KOSHSETU_FDR_HMAC_KEY=change-me-local-only
KOSHSETU_MOCK_BANK_ENABLED=true
KOSHSETU_STORAGE_ROOT=./data/objects
KOSHSETU_MAX_UPLOAD_BYTES=10485760
KOSHSETU_CORS_ORIGINS=http://localhost:5173

# --- hosted deployment (set these in the platform's environment settings) ---
# KOSHSETU_ENVIRONMENT=demo
# KOSHSETU_STORAGE_BACKEND=database      # the runtime has no durable disk
# KOSHSETU_DATABASE_URL=                 # or DATABASE_URL from the Postgres add-on
# KOSHSETU_JWT_SECRET=                   # openssl rand -hex 32
# KOSHSETU_FDR_HMAC_KEY=                 # openssl rand -hex 32
# KOSHSETU_BOOTSTRAP_SECRET=             # or CRON_SECRET; guards /ops routes
# KOSHSETU_EXPOSE_DOCS=false             # keep interactive docs off a public URL
